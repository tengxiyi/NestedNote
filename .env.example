# 环境变量样例（复制为 .env 并填入真实值）
#
# ⚠️ .env 已被 .gitignore 忽略，**禁止**提交任何真实凭据（铁律 V5 / S1）。

# ------------------------------------------------------------------ 服务端
# 监听地址（默认 0.0.0.0:8080）
NESTED_BIND_ADDR=127.0.0.1:8080

# PostgreSQL 连接串
# 未设置时服务仍可启动，但 /readyz 会返回 503（便于只调 HTTP 层）
DATABASE_URL=postgres://nested:nested-dev-only@localhost:5432/nested

# 单次请求体上限（字节），默认 16 MiB
NESTED_MAX_BODY_BYTES=16777216

# 日志级别：error / warn / info / debug / trace，或按模块细化
NESTED_LOG=info

# 对象存储（P6 起使用；开发环境指向 docker-compose 里的 MinIO）
# 注意：这些值**不得**用于生产
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nested-attachments
S3_ACCESS_KEY=nested-dev
S3_SECRET_KEY=nested-dev-only

# ------------------------------------------------------------------ 客户端
# 数据目录（等价于 CLI 的 --data-dir）
# Windows 默认：%USERPROFILE%\NestedNote
NESTED_HOME=

# 同步服务地址（P6 起使用）
NESTED_SERVER_URL=http://127.0.0.1:8080

# 设备标识由客户端首次启动时生成并持久化，通常**不需要**手工设置；
# 仅调试多设备场景时使用
# NESTED_DEVICE_ID=
